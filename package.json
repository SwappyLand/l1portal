{
  "name": "l1-portal",
  "version": "1.0.0",
  "private": true,
  "description": "L1 operations portal with server-side authentication and PostgreSQL persistence",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/copy-assets.js && tailwindcss -i ./src/input.css -o ./public/app.css --minify",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check auth.js && node --check lib/validation.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "argon2": "^0.41.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.17"
  }
}
